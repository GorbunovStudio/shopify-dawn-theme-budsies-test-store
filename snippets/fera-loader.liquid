{% if settings.fera_enable and settings.fera_public_api_key != blank %}
	<script>
		window.feraStandaloneMode = true;
		window.fera = window.fera || [];
		window.fera.push('configure', {
			api_key: "{{ settings.fera_public_api_key | escape }}",
			app_url: "https://app.fera.ai/",
			api_url: "https://app.fera.ai/api/",
		});
	</script>
	<script async defer type="application/javascript" src="https://cdn.fera.ai/js/v3/fera.js"></script>
{% endif %}
